/**
 * Convert ChordSheetJS-like parsed lines into Strum Machine "8 slots per lyric line"
 * (4/4 bluegrass assumptions):
 *  - 4 lines per verse/chorus (you feed them line-by-line)
 *  - each line => 8 "notes" (eighth-note slots): string[8]
 *
 * Rules (as discussed):
 *  - If 1 chord on the line:
 *      - if chord starts at beginning-ish => chord * 8
 *      - if chord is late-ish and prevChord exists => prevChord * 4 + chord * 4
 *  - If 2 chords on the line:
 *      - if 2nd chord is early => chord1 * 4 + chord2 * 4
 *      - if 2nd chord is late  => chord1/prevChord * 4 + chord2 * 4
 *  - If 3+ chords on the line:
 *      - take first 3: chord1 * 2 + chord2 * 2 + chord3 * 4
 *  - Empty line chords:
 *      - if prevChord exists => prevChord * 8
 *
 * "early-ish / late-ish" is inferred from where chord changes occur in the lyric text.
 */

 type ChordLyricsPair = {
    type: "chordLyricsPair";
    chords: string;        // chord symbol or "" if none
    lyrics: string;        // lyric segment following this chord
    annotation?: string;
    chord?: any;
  };
  
  type ParsedLine = {
    type: "line";
    items: ChordLyricsPair[];
  };
  
  type SlotLine = {
    slots: string[];     // length 8
    chords: string[];    // chords detected on that line (in order)
    lyricText: string;   // full lyric text for the line (no chords)
  };
  
  type ConvertResult = {
    lines: SlotLine[];
    flat: string[];      // all slots concatenated (useful if API wants flat)
  };
  
  function repeat(ch: string, n: number): string[] {
    return Array.from({ length: n }, () => ch);
  }
  
  function isBlankChord(s: string | null | undefined): boolean {
    return !s || !s.trim();
  }
  
  function normalizeChord(s: string): string {
    return s.trim();
  }
  
  /**
   * Extract chords with a "position" in the lyric text.
   * We compute each chord's position as the number of lyric characters *before* its lyrics chunk.
   *
   * Example line items:
   *   ["By and ", {C:"by "}, "Lord, by and ", {G:"by,"}]
   * Positions will land around where the chord tag appears in the human-readable line.
   */
  function extractChordsWithPositions(line: ParsedLine): {
    lyricText: string;
    chords: Array<{ chord: string; pos: number }>;
  } {
    let lyricSoFar = "";
    const chords: Array<{ chord: string; pos: number }> = [];
  
    for (const it of line.items) {
      // chord appears *before* this lyrics chunk
      const chordText = it.chords;
      if (!isBlankChord(chordText)) {
        chords.push({ chord: normalizeChord(chordText), pos: lyricSoFar.length });
      }
      lyricSoFar += it.lyrics ?? "";
    }
  
    return { lyricText: lyricSoFar, chords };
  }
  
  /**
   * Decide whether the relevant chord-change is "early" or "late" in the line.
   * We use the position of the 2nd chord (or only chord, for the "late single chord" case).
   */
  function isLate(pos: number, lineLen: number, threshold = 0.55): boolean {
    // threshold: >55% into the line is "late"
    if (lineLen <= 0) return false;
    return (pos / lineLen) >= threshold;
  }
  
  function lineTo8Slots(
    line: ParsedLine,
    prevChord: string | null
  ): { slots: string[]; nextPrevChord: string | null; chords: string[]; lyricText: string } {
    const { lyricText, chords } = extractChordsWithPositions(line);
    const chordSyms = chords.map(c => c.chord);
  
    // No chords: carry prevChord if present
    if (chordSyms.length === 0) {
      if (!prevChord) {
        // No chord to carry; return empty slots (or throw). Here we default to blanks.
        return { slots: Array(8).fill(""), nextPrevChord: prevChord, chords: [], lyricText };
      }
      return { slots: repeat(prevChord, 8), nextPrevChord: prevChord, chords: [], lyricText };
    }
  
    // 3+ chords: use bluegrass cadence: 2,2,4 on first three
    if (chordSyms.length >= 3) {
      const [a, b, c] = chordSyms;
      const slots = [...repeat(a, 2), ...repeat(b, 2), ...repeat(c, 4)];
      return { slots, nextPrevChord: c, chords: chordSyms, lyricText };
    }
  
    // 2 chords: split into halves; if the first chord is "missing" (rare in this structure),
    // carry prevChord for first half.
    if (chordSyms.length === 2) {
      const [aRaw, b] = chordSyms;
  
      // If a is present, use it; otherwise fallback to prevChord
      const a = !isBlankChord(aRaw) ? aRaw : (prevChord ?? b);
  
      // Determine whether chord change is "early" based on 2nd chord position
      const secondPos = chords[1].pos;
      const late = isLate(secondPos, lyricText.length);
  
      // In both cases we still do 4 + 4, but "late" matters when the first chord is implicit/carryover.
      // (You can expand this later to do 6+2 etc. if you want more nuance.)
      const slots = [...repeat(a, 4), ...repeat(b, 4)];
      return { slots, nextPrevChord: b, chords: chordSyms, lyricText };
    }
  
    // 1 chord: either all 8, or carry prevChord for first half if chord is late-ish
    {
      const a = chordSyms[0];
      const aPos = chords[0].pos;
      const late = isLate(aPos, lyricText.length);
  
      if (late && prevChord) {
        const slots = [...repeat(prevChord, 4), ...repeat(a, 4)];
        return { slots, nextPrevChord: a, chords: chordSyms, lyricText };
      }
      const slots = repeat(a, 8);
      return { slots, nextPrevChord: a, chords: chordSyms, lyricText };
    }
  }
  
  /**
   * Convert an array of parsed lines (type:"line") to Strum Machine slot rows (8 per line).
   */
  export function convertChordSheetLinesToStrumSlots(lines: ParsedLine[]): ConvertResult {
    const outLines: SlotLine[] = [];
    let prev: string | null = null;
  
    for (const ln of lines) {
      if (ln.type !== "line") continue;
  
      const { slots, nextPrevChord, chords, lyricText } = lineTo8Slots(ln, prev);
      outLines.push({ slots, chords, lyricText });
      prev = nextPrevChord;
    }
  
    return { lines: outLines, flat: outLines.flatMap(l => l.slots) };
  }
  
  // ------------------
  // Example with your input
  // ------------------
  
  const exampleLines: ParsedLine[] = [
    {
      type: "line",
      items: [
        { type: "chordLyricsPair", chords: "G", chord: null, lyrics: "Will ", annotation: "" },
        { type: "chordLyricsPair", chords: "", chord: null, lyrics: "the circle be unbroken", annotation: "" },
      ],
    },
    {
      type: "line",
      items: [
        { type: "chordLyricsPair", chords: "", chord: null, lyrics: "By and ", annotation: "" },
        { type: "chordLyricsPair", chords: "C", chord: null, lyrics: "by ", annotation: "" },
        { type: "chordLyricsPair", chords: "", chord: null, lyrics: "Lord, by and ", annotation: "" },
        { type: "chordLyricsPair", chords: "G", chord: null, lyrics: "by,", annotation: "" },
      ],
    },
    {
      type: "line",
      items: [
        { type: "chordLyricsPair", chords: "", chord: null, lyrics: "There's a better world home a-", annotation: "" },
        { type: "chordLyricsPair", chords: "Em", chord: null, lyrics: "waiting", annotation: "" },
      ],
    },
    {
      type: "line",
      items: [
        { type: "chordLyricsPair", chords: "", chord: null, lyrics: "In the ", annotation: "" },
        { type: "chordLyricsPair", chords: "G", chord: null, lyrics: "sky ", annotation: "" },
        { type: "chordLyricsPair", chords: "", chord: null, lyrics: "Lord, ", annotation: "" },
        { type: "chordLyricsPair", chords: "D", chord: null, lyrics: "in ", annotation: "" },
        { type: "chordLyricsPair", chords: "", chord: null, lyrics: "the ", annotation: "" },
        { type: "chordLyricsPair", chords: "G", chord: null, lyrics: "sky.", annotation: "" },
      ],
    },
  ];
  
  const converted = convertChordSheetLinesToStrumSlots(exampleLines);
  
  // Print rows
  for (const l of converted.lines) {
    console.log(l.slots.join(" "));
  }
  
  // Expected with the heuristics:
  /// G G G G G G G G
  /// C C C C G G G G
  /// G G G G Em Em Em Em   (because Em is late-ish on that line)
  /// G G D D G G G G
  